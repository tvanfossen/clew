{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from clew-trace==1.3.0 clew-hook --read"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from clew-trace==1.3.0 clew-hook --pattern"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from clew-trace==1.3.0 clew-hook --glob"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from clew-trace==1.3.0 clew-hook --shell"
          }
        ]
      },
      {
        "matcher": "mcp__.*clew.*",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from clew-trace==1.3.0 clew-hook --used"
          }
        ]
      }
    ]
  }
}
