{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "clew-hook"
          }
        ]
      },
      {
        "matcher": "mcp__.*clew.*",
        "hooks": [
          {
            "type": "command",
            "command": "clew-hook --used"
          }
        ]
      }
    ]
  }
}
